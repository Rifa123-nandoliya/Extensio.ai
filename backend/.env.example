NODE_ENV=development
MONGO_URI=mongodb://localhost:27017
JWT_SECRET=your-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
PORT=5000
GROQ_API_KEY=

# Optional: comma-separated list when frontend has multiple origins
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# Cross-site cookies (required for Vercel frontend + Render backend)
# COOKIE_SAME_SITE=none

# Logging: debug | info | warn | error
# LOG_LEVEL=info

# Stripe — see STRIPE_SETUP.md
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id
